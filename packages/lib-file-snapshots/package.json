{
  "name": "@cronn/lib-file-snapshots",
  "version": "1.2.2",
  "description": "The library agnostic core for testing file snapshots",
  "keywords": [
    "file snapshots"
  ],
  "homepage": "https://github.com/cronn/file-snapshots",
  "bugs": {
    "url": "https://github.com/cronn/file-snapshots/issues"
  },
  "license": "Apache-2.0",
  "author": "cronn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cronn/file-snapshots.git",
    "directory": "packages/lib-file-snapshots"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf .turbo dist coverage",
    "compile": "tsc",
    "lint:check": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --max-warnings=0 --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "markdown-table": "catalog:prod"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@cronn/shared-configs": "workspace:*",
    "@types/node": "catalog:dev",
    "@typescript/native": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "eslint-plugin-check-file": "catalog:dev",
    "eslint-plugin-unused-imports": "catalog:dev",
    "publint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  }
}
