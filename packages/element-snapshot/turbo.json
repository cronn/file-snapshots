{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "playwright:install": {
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration"]
    },
    "test:unit": {
      "dependsOn": ["^build", "compile"],
      "outputLogs": "new-only",
      "outputs": ["data/unit-test/output/**"]
    },
    "test:unit:coverage": {
      "dependsOn": ["^build", "compile"],
      "outputs": ["coverage/**", "data/unit-test/output/**"],
      "outputLogs": "new-only"
    },
    "test:integration": {
      "dependsOn": ["^build", "compile", "build", "playwright:install"],
      "outputs": [
        "playwright-report/**",
        "test-results/**",
        "data/integration-test/output/**"
      ],
      "outputLogs": "new-only"
    },
    "snapshots:check": {
      "dependsOn": ["^build", "test:unit:coverage", "test:integration"],
      "cache": false,
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": [
        "compile",
        "lint:check",
        "test:unit:coverage",
        "test:integration",
        "snapshots:check",
        "//#format:check"
      ]
    }
  }
}
