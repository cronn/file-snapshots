{
  "name": "@cronn/element-snapshot",
  "version": "0.30.0",
  "description": "Element snapshots for Playwright",
  "homepage": "https://cronn.github.io/file-snapshots/playwright/element-snapshots/",
  "bugs": {
    "url": "https://github.com/cronn/file-snapshots/issues"
  },
  "license": "Apache-2.0",
  "author": "cronn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cronn/file-snapshots.git",
    "directory": "packages/element-snapshot"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf .turbo dist playwright-report test-results coverage",
    "compile": "tsc",
    "lint:check": "eslint src/ tests/ --max-warnings=0",
    "lint:fix": "eslint src/ tests/ --max-warnings=0 --fix",
    "playwright:install": "playwright install chromium",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cronn/lib-file-snapshots": "workspace:*",
    "@cronn/playwright-file-snapshots": "workspace:*",
    "package-directory": "catalog:prod"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@cronn/shared-configs": "workspace:*",
    "@cronn/test-utils": "workspace:*",
    "@cronn/vitest-file-snapshots": "workspace:*",
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/native": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "eslint-plugin-check-file": "catalog:dev",
    "eslint-plugin-unused-imports": "catalog:dev",
    "publint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "@playwright/test": "^1.55"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  }
}
