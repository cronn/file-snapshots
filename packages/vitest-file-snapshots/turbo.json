{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": [
        "test:core",
        "test:update-new",
        "test:update-all",
        "test:update-none"
      ]
    },
    "test:core": {
      "dependsOn": ["^build", "compile"],
      "outputLogs": "new-only",
      "outputs": ["data/test/output/**", "custom-data/output/**"]
    },
    "test:update-new": {
      "dependsOn": ["^build", "compile"],
      "outputLogs": "new-only",
      "outputs": ["data/test/output/**", "custom-data/output/**"]
    },
    "test:update-all": {
      "dependsOn": ["^build", "compile"],
      "outputLogs": "new-only",
      "outputs": ["data/test/output/**", "custom-data/output/**"]
    },
    "test:update-none": {
      "dependsOn": ["^build", "compile"],
      "outputLogs": "new-only",
      "outputs": ["data/test/output/**", "custom-data/output/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "compile"],
      "outputs": [
        "coverage/**",
        "data/test/output/**",
        "custom-data/output/**"
      ],
      "outputLogs": "new-only"
    },
    "snapshots:check": {
      "dependsOn": [
        "^build",
        "test:coverage",
        "test:update-new",
        "test:update-all",
        "test:update-none"
      ],
      "cache": false,
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": [
        "compile",
        "lint:check",
        "test:coverage",
        "test:update-new",
        "test:update-all",
        "test:update-none",
        "snapshots:check",
        "//#format:check"
      ]
    }
  }
}
