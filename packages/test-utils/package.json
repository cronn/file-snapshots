{
  "name": "@cronn/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Internal test utils for the monorepo",
  "homepage": "https://github.com/cronn/file-snapshots",
  "license": "Apache-2.0",
  "author": "cronn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cronn/file-snapshots.git",
    "directory": "packages/test-utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "default": "./dist/playwright.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf .turbo dist",
    "compile": "tsc",
    "lint:check": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --max-warnings=0 --fix"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@cronn/shared-configs": "workspace:*",
    "@playwright/test": "catalog:dev",
    "@typescript/native": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "eslint-plugin-check-file": "catalog:dev",
    "eslint-plugin-unused-imports": "catalog:dev",
    "publint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "typescript-eslint": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  }
}
